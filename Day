#include <iostream>
using namespace std;
int main() {
  int d;
  cout<<"Enter number for day: ";
  cin>>d;
  switch(d)
  {
      case 1:cout<<"Monday";
      break;
      case 2:cout<<"Tuesday";
      break;
      case 3:cout<<"Wednessday";
      break;
      case 4:cout<<"Thursday";
      break;
      case 5:cout<<"Friday";
      break;
      case 6:cout<<"Weekend";
      break;
      case 7:cout<<"Weekend";
      break;
      default:cout<<"invalid day";
      break;
  }
}
